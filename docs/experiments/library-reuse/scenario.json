{
  "id": "LIB-SC-1",
  "description": "Controlled scenario for the Library Lending API (fresh API, empty database). Loan A goes through the full lifecycle and is then re-issued (forbidden, RETURNED is final); loan B tries to skip approval (forbidden); loan C is rejected and then approved (forbidden, REJECTED is final). Read-backs and the member list expose persisted state; an unknown id (404) and an invalid status value (400) check that rules stay out of requests they do not cover.",
  "steps": [
    { "name": "0 create loan A", "operationId": "createLoan", "body": { "memberId": 42, "bookId": 1001 }, "save": { "a": "$.id" },
      "expect": { "status": 201, "loanStatus": "REQUESTED" } },
    { "name": "1 A -> APPROVED", "operationId": "updateLoanStatus", "pathParams": { "id": "${a}" }, "body": { "status": "APPROVED" },
      "expect": { "status": 200, "loanStatus": "APPROVED" } },
    { "name": "2 A -> ISSUED", "operationId": "updateLoanStatus", "pathParams": { "id": "${a}" }, "body": { "status": "ISSUED" },
      "expect": { "status": 200, "loanStatus": "ISSUED" } },
    { "name": "3 A -> RETURNED", "operationId": "updateLoanStatus", "pathParams": { "id": "${a}" }, "body": { "status": "RETURNED" },
      "expect": { "status": 200, "loanStatus": "RETURNED" } },
    { "name": "4 A -> ISSUED (forbidden: RETURNED is final)", "operationId": "updateLoanStatus", "pathParams": { "id": "${a}" }, "body": { "status": "ISSUED" },
      "expect": { "status": 409 } },
    { "name": "5 read A", "operationId": "getLoan", "pathParams": { "id": "${a}" },
      "expect": { "status": 200, "loanStatus": "RETURNED" } },
    { "name": "6 create loan B", "operationId": "createLoan", "body": { "memberId": 42, "bookId": 1002 }, "save": { "b": "$.id" },
      "expect": { "status": 201, "loanStatus": "REQUESTED" } },
    { "name": "7 B -> ISSUED (forbidden: approval skipped)", "operationId": "updateLoanStatus", "pathParams": { "id": "${b}" }, "body": { "status": "ISSUED" },
      "expect": { "status": 409 } },
    { "name": "8 read B", "operationId": "getLoan", "pathParams": { "id": "${b}" },
      "expect": { "status": 200, "loanStatus": "REQUESTED" } },
    { "name": "9 create loan C", "operationId": "createLoan", "body": { "memberId": 42, "bookId": 1003 }, "save": { "c": "$.id" },
      "expect": { "status": 201, "loanStatus": "REQUESTED" } },
    { "name": "10 C -> REJECTED", "operationId": "updateLoanStatus", "pathParams": { "id": "${c}" }, "body": { "status": "REJECTED" },
      "expect": { "status": 200, "loanStatus": "REJECTED" } },
    { "name": "11 C -> APPROVED (forbidden: REJECTED is final)", "operationId": "updateLoanStatus", "pathParams": { "id": "${c}" }, "body": { "status": "APPROVED" },
      "expect": { "status": 409 } },
    { "name": "12 list member 42", "operationId": "listMemberLoans", "pathParams": { "memberId": "42" },
      "expect": { "status": 200, "listStatuses": ["RETURNED", "REQUESTED", "REJECTED"] } },
    { "name": "13 unknown loan -> APPROVED", "operationId": "updateLoanStatus", "pathParams": { "id": "00000000-0000-4000-8000-000000000000" }, "body": { "status": "APPROVED" },
      "expect": { "status": 404 } },
    { "name": "14 A -> LOST (not a status)", "operationId": "updateLoanStatus", "pathParams": { "id": "${a}" }, "body": { "status": "LOST" },
      "expect": { "status": 400 } }
  ]
}
