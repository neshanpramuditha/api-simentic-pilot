{
  "id": "EVT-SC-1",
  "description": "Controlled scenario for the Event Registration API (fresh API, empty database). R1 is confirmed and checked in, then a forbidden cancellation is attempted; R2 is wait-listed, confirmed, cancelled with a reason; R3 is wait-listed and a forbidden check-in is attempted. Each forbidden attempt is on a registration that is only read afterwards, so one defect's effect does not cascade into another step. Ends with the attendee list (envelope), an unknown id (404) and two invalid requests (400).",
  "steps": [
    { "name": "0 register R1", "operationId": "registerAttendee", "body": { "attendeeRef": "ATT-7", "eventCode": "JAVA-CONF-26", "seats": 2 }, "save": { "r1": "$.registrationId" },
      "expect": { "status": 201, "state": "REQUESTED" } },
    { "name": "1 R1 -> CONFIRMED", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r1}" }, "body": { "to": "CONFIRMED" },
      "expect": { "status": 200, "state": "CONFIRMED" } },
    { "name": "2 R1 -> CHECKED_IN", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r1}" }, "body": { "to": "CHECKED_IN" },
      "expect": { "status": 200, "state": "CHECKED_IN" } },
    { "name": "3 fetch R1", "operationId": "fetchRegistration", "pathParams": { "registrationId": "${r1}" },
      "expect": { "status": 200, "state": "CHECKED_IN" } },
    { "name": "4 R1 -> CANCELLED (forbidden: CHECKED_IN is final)", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r1}" }, "body": { "to": "CANCELLED", "reason": "Left early" },
      "expect": { "status": 422 } },
    { "name": "5 fetch R1", "operationId": "fetchRegistration", "pathParams": { "registrationId": "${r1}" },
      "expect": { "status": 200, "state": "CHECKED_IN" } },
    { "name": "6 register R2", "operationId": "registerAttendee", "body": { "attendeeRef": "ATT-7", "eventCode": "SPRING-DAY", "seats": 1 }, "save": { "r2": "$.registrationId" },
      "expect": { "status": 201, "state": "REQUESTED" } },
    { "name": "7 R2 -> WAITLISTED", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r2}" }, "body": { "to": "WAITLISTED" },
      "expect": { "status": 200, "state": "WAITLISTED" } },
    { "name": "8 R2 -> CONFIRMED", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r2}" }, "body": { "to": "CONFIRMED" },
      "expect": { "status": 200, "state": "CONFIRMED" } },
    { "name": "9 R2 -> CANCELLED with reason", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r2}" }, "body": { "to": "CANCELLED", "reason": "Schedule conflict" },
      "expect": { "status": 200, "state": "CANCELLED" } },
    { "name": "10 fetch R2", "operationId": "fetchRegistration", "pathParams": { "registrationId": "${r2}" },
      "expect": { "status": 200, "state": "CANCELLED" } },
    { "name": "11 register R3", "operationId": "registerAttendee", "body": { "attendeeRef": "ATT-7", "eventCode": "API-SUMMIT", "seats": 3 }, "save": { "r3": "$.registrationId" },
      "expect": { "status": 201, "state": "REQUESTED" } },
    { "name": "12 R3 -> WAITLISTED", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r3}" }, "body": { "to": "WAITLISTED" },
      "expect": { "status": 200, "state": "WAITLISTED" } },
    { "name": "13 R3 -> CHECKED_IN (forbidden: not confirmed)", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r3}" }, "body": { "to": "CHECKED_IN" },
      "expect": { "status": 422 } },
    { "name": "14 fetch R3", "operationId": "fetchRegistration", "pathParams": { "registrationId": "${r3}" },
      "expect": { "status": 200, "state": "WAITLISTED" } },
    { "name": "15 list ATT-7", "operationId": "listAttendeeRegistrations", "pathParams": { "attendeeRef": "ATT-7" },
      "expect": { "status": 200, "listStates": ["CHECKED_IN", "CANCELLED", "WAITLISTED"] } },
    { "name": "16 unknown registration -> CONFIRMED", "operationId": "transitionRegistration", "pathParams": { "registrationId": "REG-NOPE0000" }, "body": { "to": "CONFIRMED" },
      "expect": { "status": 404 } },
    { "name": "17 R3 -> DONE (not a state)", "operationId": "transitionRegistration", "pathParams": { "registrationId": "${r3}" }, "body": { "to": "DONE" },
      "expect": { "status": 400 } },
    { "name": "18 register with 0 seats", "operationId": "registerAttendee", "body": { "attendeeRef": "ATT-7", "eventCode": "JAVA-CONF-26", "seats": 0 },
      "expect": { "status": 400 } }
  ]
}
