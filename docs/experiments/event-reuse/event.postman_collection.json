  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const registrationSchema = {\"properties\":{\"attendeeRef\":{\"type\":\"string\"},\"cancellationReason\":{\"maxLength\":200,\"type\":[\"string\",\"null\"]},\"cancelledAt\":{\"type\":[\"string\",\"null\"]},\"checkedInAt\":{\"type\":[\"string\",\"null\"]},\"confirmedAt\":{\"type\":[\"string\",\"null\"]},\"eventCode\":{\"type\":\"string\"},\"registrationId\":{\"pattern\":\"^REG-[A-Z0-9]{8}$\",\"type\":\"string\"},\"requestedAt\":{\"type\":\"string\"},\"seats\":{\"maximum\":4,\"minimum\":1,\"type\":\"integer\"},\"state\":{\"enum\":[\"REQUESTED\",\"WAITLISTED\",\"CONFIRMED\",\"CHECKED_IN\",\"CANCELLED\"],\"type\":\"string\"}},\"required\":[\"attendeeRef\",\"cancellationReason\",\"cancelledAt\",\"checkedInAt\",\"confirmedAt\",\"eventCode\",\"registrationId\",\"requestedAt\",\"seats\",\"state\"],\"type\":\"object\"};",
          "const envelopeSchema = {\"properties\":{\"attendeeRef\":{\"type\":\"string\"},\"count\":{\"type\":\"integer\"},\"items\":{\"type\":\"array\",\"items\":{\"properties\":{\"attendeeRef\":{\"type\":\"string\"},\"cancellationReason\":{\"maxLength\":200,\"type\":[\"string\",\"null\"]},\"cancelledAt\":{\"type\":[\"string\",\"null\"]},\"checkedInAt\":{\"type\":[\"string\",\"null\"]},\"confirmedAt\":{\"type\":[\"string\",\"null\"]},\"eventCode\":{\"type\":\"string\"},\"registrationId\":{\"pattern\":\"^REG-[A-Z0-9]{8}$\",\"type\":\"string\"},\"requestedAt\":{\"type\":\"string\"},\"seats\":{\"maximum\":4,\"minimum\":1,\"type\":\"integer\"},\"state\":{\"enum\":[\"REQUESTED\",\"WAITLISTED\",\"CONFIRMED\",\"CHECKED_IN\",\"CANCELLED\"],\"type\":\"string\"}},\"required\":[\"attendeeRef\",\"cancellationReason\",\"cancelledAt\",\"checkedInAt\",\"confirmedAt\",\"eventCode\",\"registrationId\",\"requestedAt\",\"seats\",\"state\"],\"type\":\"object\"}}},\"required\":[\"attendeeRef\",\"count\",\"items\"],\"type\":\"object\"};",
          "const ok = pm.response.code >= 200 && pm.response.code < 300;",
          "let body = null; try { body = pm.response.json(); } catch (e) { body = null; }",
          "const isEnvelope = body && Array.isArray(body.items);",
          "const regs = !ok || !body ? [] : isEnvelope ? body.items : (body.registrationId ? [body] : []);",
          "if (ok && body) pm.test(\"[schema] body matches the OpenAPI \" + (isEnvelope ? \"AttendeeRegistrations\" : \"Registration\") + \" schema\", () => pm.response.to.have.jsonSchema(isEnvelope ? envelopeSchema : registrationSchema));",
          "const set = v => v !== null && v !== undefined;",
          "const t = v => Date.parse(v);",
          "regs.forEach((r, i) => {",
          "  const at = isEnvelope ? \" (item \" + i + \")\" : \"\";",
          "  pm.test(\"[INV-001] checkedInAt set iff CHECKED_IN\" + at, () => pm.expect(set(r.checkedInAt), JSON.stringify({ state: r.state, checkedInAt: r.checkedInAt })).to.eql(r.state === \"CHECKED_IN\"));",
          "  pm.test(\"[INV-002] cancelledAt set iff CANCELLED\" + at, () => pm.expect(set(r.cancelledAt), JSON.stringify({ state: r.state, cancelledAt: r.cancelledAt })).to.eql(r.state === \"CANCELLED\"));",
          "  pm.test(\"[INV-003] cancellationReason set iff CANCELLED\" + at, () => pm.expect(set(r.cancellationReason), JSON.stringify({ state: r.state, cancellationReason: r.cancellationReason })).to.eql(r.state === \"CANCELLED\"));",
          "  pm.test(\"[INV-004] CHECKED_IN implies confirmedAt; confirmedAt only in CONFIRMED/CHECKED_IN/CANCELLED\" + at, () => {",
          "    if (r.state === \"CHECKED_IN\") pm.expect(r.confirmedAt, \"confirmedAt of a CHECKED_IN registration\").to.not.equal(null);",
          "    if (set(r.confirmedAt)) pm.expect([\"CONFIRMED\", \"CHECKED_IN\", \"CANCELLED\"], \"state with confirmedAt\").to.include(r.state);",
          "  });",
          "  pm.test(\"[INV-005] requestedAt <= confirmedAt <= checkedInAt\" + at, () => {",
          "    if (set(r.confirmedAt)) pm.expect(t(r.requestedAt), \"requestedAt \" + r.requestedAt + \" vs confirmedAt \" + r.confirmedAt).to.be.at.most(t(r.confirmedAt));",
          "    if (set(r.checkedInAt)) pm.expect(t(r.confirmedAt), \"confirmedAt \" + r.confirmedAt + \" vs checkedInAt \" + r.checkedInAt).to.be.at.most(t(r.checkedInAt));",
          "  });",
          "});",
          "// Snapshot of each registration as last observed, for the read-back check after rejected transitions.",
          "const before = {};",
          "regs.forEach(r => { before[r.registrationId] = pm.collectionVariables.get(\"snap_\" + r.registrationId); pm.collectionVariables.set(\"snap_\" + r.registrationId, JSON.stringify(r)); });",
          "const m = pm.request.url.getPath().match(/^\\/v1\\/registrations\\/([^/]+)\\/transitions$/);",
          "if (m) {",
          "  const id = m[1];",
          "  const previous = ok ? null : pm.collectionVariables.get(\"snap_\" + id);",
          "  pm.sendRequest({ url: pm.variables.get(\"baseUrl\") + \"/v1/registrations/\" + id, method: \"GET\", header: { Accept: \"application/json\" } }, (err, res) => {",
          "    if (err || res.code !== 200) return;",
          "    const stored = res.json();",
          "    // Revision 1: the API returns 100 ns timestamps but stores microseconds, so timestamps are compared within 1 ms.",
          "    const same = (a, b) => [\"state\", \"cancellationReason\"].every(k => a[k] === b[k])",
          "      && [\"confirmedAt\", \"checkedInAt\", \"cancelledAt\"].every(k => set(a[k]) === set(b[k]) && (!set(a[k]) || Math.abs(t(a[k]) - t(b[k])) < 1));",
          "    const view = r => JSON.stringify({ state: r.state, confirmedAt: r.confirmedAt, checkedInAt: r.checkedInAt, cancelledAt: r.cancelledAt, cancellationReason: r.cancellationReason });",
          "    if (ok) pm.test(\"[READBACK] stored registration equals the \" + pm.response.code + \" response\", () => pm.expect(same(stored, body), \"read-back GET \" + view(stored) + \" vs response \" + view(body)).to.eql(true));",
          "    else if (previous) pm.test(\"[READBACK] registration unchanged after HTTP \" + pm.response.code, () => pm.expect(same(stored, JSON.parse(previous)), \"read-back GET \" + view(stored) + \" vs before \" + view(JSON.parse(previous))).to.eql(true));",
          "    pm.collectionVariables.set(\"snap_\" + id, JSON.stringify(stored));",
          "  });",
          "}"
        ]
      }
    }
  ],
